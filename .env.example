# ==============================================================================
# 🛠️ Variáveis de Ambiente e Configurações: Avatar Falante com IA
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente:
#   copy .env.example .env (Windows) ou cp .env.example .env (Linux/macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Servidor FastAPI & WebSocket
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
RELOAD=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","*"]

# ------------------------------------------------------------------------------
# 🧠 LLM Local (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Modelos sugeridos: qwen2.5:3b-instruct, llama3.2:3b, qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:3b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ------------------------------------------------------------------------------
# 📚 RAG & Base de Conhecimento (ChromaDB & Embeddings)
# ------------------------------------------------------------------------------
# Modelo de Embedding: BAAI/bge-m3 (via FastEmbed) ou nomic-embed-text (via Ollama)
EMBEDDING_MODEL=BAAI/bge-m3
DOCUMENTS_DIRECTORY=data/documents
CHROMA_PERSIST_DIRECTORY=data/vector_store
CHROMA_COLLECTION_NAME=avatar_knowledge_base
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RAG_SCORE_THRESHOLD=0.65
RAG_TOP_K=4

# ------------------------------------------------------------------------------
# 🎙️ STT: Reconhecimento de Voz (faster-whisper)
# ------------------------------------------------------------------------------
# Modelos: tiny, base, small, medium (base ou small recomendados para pt)
WHISPER_MODEL=base
WHISPER_LANGUAGE=pt
# Dispositivo: cpu ou cuda
WHISPER_DEVICE=cpu
# Tipo de computação: int8, float16, float32 (int8 ideal para CPU)
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODELS_DIR=models/whisper

# ------------------------------------------------------------------------------
# 🔊 TTS: Síntese de Voz (Piper TTS)
# ------------------------------------------------------------------------------
# Caminho para o executável do Piper e modelos .onnx
PIPER_BINARY_PATH=models/piper/piper.exe
PIPER_MODEL_PATH=models/piper/pt_BR-faber-medium.onnx
PIPER_CONFIG_PATH=models/piper/pt_BR-faber-medium.onnx.json

# ------------------------------------------------------------------------------
# 🎚️ VAD & Áudio em Tempo Real (Silero VAD)
# ------------------------------------------------------------------------------
# Limiar de probabilidade de fala (0.0 a 1.0)
VAD_THRESHOLD=0.5
# Duração mínima de silêncio para considerar término de fala (em milissegundos)
SILENCE_DURATION_MS=700
# Taxa de amostragem padrão de áudio
AUDIO_SAMPLE_RATE=16000
